{
    "ios":  {
                "contentInset":  "always"
            },
    "appName":  "Loop GPT",
    "server":  {
                   "cleartext":  false,
                   "url":  "https://loop-gpt.cyou",
                   "androidScheme":  "https"
               },
    "plugins":  {
                    "SplashScreen":  {
                                         "launchShowDuration":  1200,
                                         "splashFullScreen":  true,
                                         "launchAutoHide":  true,
                                         "backgroundColor":  "#06060a",
                                         "splashImmersive":  true,
                                         "showSpinner":  false
                                     },
                    "StatusBar":  {
                                      "overlaysWebView":  true,
                                      "style":  "DARK",
                                      "backgroundColor":  "#06060a"
                                  }
                },
    "webDir":  "www",
    "appId":  "cyou.loopgpt.app"
}
